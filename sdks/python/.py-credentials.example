# Copy to ~/.py-credentials (recommended) or packages/sdk-python/.py-credentials
#   cp .py-credentials.example ~/.py-credentials
#   chmod 600 ~/.py-credentials
#
# PyPI API tokens: https://pypi.org/manage/account/token/
# TestPyPI:        https://test.pypi.org/manage/account/token/
#
# Twine always uses username __token__; only the token value goes here.

[pypi]
token = pypi-REPLACE_ME

[testpypi]
token = pypi-REPLACE_ME
