{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["./**/*.ts", "../src/**/*.ts"],
  "exclude": ["../src/**/*.spec.ts", "../src/**/*.test.ts", "../src/**/__tests__/**"]
}
