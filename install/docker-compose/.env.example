# TensorCost GPU Agent — environment configuration
# Copy this file to .env and fill in the values from the onboarding wizard.
# Never commit the filled-in .env file to version control.

# ── Required: from the TensorCost onboarding wizard ───────────────────────────
BACKEND_API_URL=https://api.dev.tensorcost.com
TENANT_ID=<your-tenant-uuid>
AGENT_API_KEY=<your-agent-api-key>
AGENT_KEY_ID=<your-agent-key-id>
AGENT_HMAC_PEPPER=<your-agent-hmac-pepper>

# ── GPU sampling (required for any GPU metrics) ───────────────────────────────
# NVML_ENABLED defaults to false in the agent. With it off the agent
# authenticates, heartbeats, and reports ZERO GPU metrics. Set it to true on any
# host with NVIDIA GPUs — this is what collects utilization, memory, temperature
# and power draw.
NVML_ENABLED=true
# How often (seconds) to sample the GPUs via NVML. Default 10.
NVML_SAMPLE_INTERVAL=10

# ── Hostname ──────────────────────────────────────────────────────────────────
# Defaults to the container's hostname when running with network_mode: host.
# Set explicitly if that doesn't match the name you registered in the wizard.
AGENT_HOSTNAME=

# ── Transport ─────────────────────────────────────────────────────────────────
# COMM_MODE: http (default) | grpc | both
# Set COMM_MODE=both and fill in GRPC_TARGET for real-time gRPC streaming.
COMM_MODE=http
GRPC_TARGET=
GRPC_USE_TLS=true

# ── Cloud monitoring (optional) ───────────────────────────────────────────────
# Enable any cloud provider to collect cost data from that cloud's billing API.
AWS_ENABLED=false
GCP_ENABLED=false
AZURE_ENABLED=false
K8S_ENABLED=false

# AWS-specific (used when AWS_ENABLED=true)
AWS_REGION=us-east-1

# GCP-specific (used when GCP_ENABLED=true)
GCP_PROJECT_ID=

# Azure-specific (used when AZURE_ENABLED=true)
AZURE_SUBSCRIPTION_ID=

# ── Monitoring cadence ────────────────────────────────────────────────────────
# How often (in seconds) to sample GPUs and push telemetry. Default: 300 (5 min)
MONITORING_INTERVAL=300

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
