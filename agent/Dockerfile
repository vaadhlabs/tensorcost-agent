# ─────────────────────────────────────────────────────────────────────────────
# Unified GPU Agent
#
# Build variants (set with --build-arg VARIANT=<name>):
#   full   — all cloud providers: AWS, GCP, Azure, Kubernetes  (default, ~600 MB)
#   aws    — AWS + SageMaker only                              (~250 MB)
#   gcp    — Google Cloud + Vertex AI only                     (~300 MB)
#   azure  — Azure only                                        (~250 MB)
#   node   — NVML local GPU metrics, no cloud SDKs             (~120 MB)
#
# Examples:
#   docker build .                                  # full
#   docker build --build-arg VARIANT=aws .          # AWS-only
#   docker build --build-arg VARIANT=node .         # per-node sidecar
# ─────────────────────────────────────────────────────────────────────────────

# Bumped from python:3.9-slim → python:3.11-slim on 2026-04-29:
#   - 3.9 reached EOL October 2025; 3.11 is current LTS.
#   - The agent code uses PEP 604 `X | Y` typing forms in places
#     (src/grpc_client.py, line 63 historically) that 3.9 raises on.
#   - More importantly, arm64 wheel coverage for our runtime deps
#     (grpcio>=1.62, protobuf 4.25.x, sagemaker, google-cloud-*) is
#     dramatically better on 3.11 than 3.9. The CI multi-arch build
#     was forced to compile several packages from source on
#     linux/arm64 + py3.9 — pushing the `full` variant from <2 min
#     to 18+ min. Bumping to 3.11 hits prebuilt wheels everywhere.
FROM python:3.11-slim

ARG VARIANT=full
ENV VARIANT=${VARIANT}

# Metadata
LABEL org.opencontainers.image.title="Unified GPU Agent"
LABEL org.opencontainers.image.description="GPU monitoring agent for AWS, GCP, Azure and Kubernetes"
LABEL org.opencontainers.image.source="https://github.com/gocloudera/unified-gpu-agent"
LABEL org.opencontainers.image.vendor="GoCloudera"

# System dependencies — only what's needed to compile grpcio
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy all variant lockfiles first (better layer caching). The .lock files
# are generated by `pip-compile --generate-hashes` from the .txt source
# files; regenerate with:
#     ./venv/bin/pip-compile --generate-hashes \
#         --output-file=requirements-<variant>.lock requirements-<variant>.txt
# whenever a .txt source changes. The .txt files are NOT copied into the
# image — pip resolves only against the hashed lockfiles at build time so
# a compromised PyPI maintainer or typosquat cannot poison a transitive
# dep on a future image build.
COPY requirements-core.lock \
     requirements-aws.lock \
     requirements-gcp.lock \
     requirements-azure.lock \
     requirements-full.lock \
     requirements-node.lock \
     ./

# Install only what this variant needs — no test deps ever reach the image.
# --require-hashes forces pip to refuse any package whose artifact hash
# isn't pinned in the lockfile, defeating index-substitution attacks.
RUN pip install --no-cache-dir --require-hashes -r requirements-${VARIANT}.lock

# Copy application code (after deps so code changes don't bust the pip layer).
# This includes src/proto/agent_pb2*.py — the proto stubs are committed in
# the source tree (pre-generated by bin/regen-proto.sh whenever the .proto
# changes upstream) so the image needs neither grpcio-tools nor protoc to
# build. An earlier revision of this Dockerfile re-ran grpc_tools.protoc
# here to "match the installed protobuf version", but that:
#   - pulled grpcio-tools 1.80+ at build time, which transitively needs
#     protobuf>=6.31 — irreconcilable with sagemaker / google-cloud-* in
#     the cloud variants (they pin protobuf<5)
#   - and broke aws / gcp / full Docker builds while azure / node passed
#     because azure / node don't drag in the conflicting cloud SDKs.
# The committed stubs work against any protobuf 4.x runtime, which is what
# the requirements resolve to. Re-vendoring is a developer-machine workflow,
# not a build-time step.
COPY src/ ./src/
COPY main.py ./

# Create non-root user
RUN useradd -m -u 1000 gpuagent && \
    chown -R gpuagent:gpuagent /app

# Writable runtime directories
RUN mkdir -p /app/data /app/logs && \
    chown -R gpuagent:gpuagent /app/data /app/logs

USER gpuagent

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import os, time, sys; \
    p='/app/data/heartbeat'; \
    sys.exit(0 if os.path.exists(p) and time.time() - os.path.getmtime(p) < 180 else 1)"

CMD ["python", "main.py"]
