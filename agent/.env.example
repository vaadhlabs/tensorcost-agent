# ─────────────────────────────────────────────────────────────────────────────
# Unified GPU Agent — environment configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Optional — TensorCost control plane (leave unset for standalone mode)
# BACKEND_API_URL=https://api.tensorcost.com
BACKEND_API_KEY=your-api-key-here
TENANT_ID=your-tenant-id-here

# Standalone exporters (no backend required)
PROMETHEUS_TEXT_ENABLED=true
PROMETHEUS_TEXT_PORT=9090
# PROMETHEUS_REMOTE_WRITE_URL=https://your-prometheus.example/api/v1/write
# FOCUS_USAGE_FILE=/var/lib/tensorcost/gpu-usage.csv
# OTEL_METRICS_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Enable cloud providers (set to true for each cloud you want to monitor)
AWS_ENABLED=false
GCP_ENABLED=false
AZURE_ENABLED=false
K8S_ENABLED=false

# AWS — region where your GPU instances run
AWS_REGION=us-east-1

# GCP — your Google Cloud project ID
GCP_PROJECT_ID=

# Azure — your Azure subscription ID
AZURE_SUBSCRIPTION_ID=

# Monitoring interval in seconds (default: 300 = 5 minutes)
MONITORING_INTERVAL=300

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
